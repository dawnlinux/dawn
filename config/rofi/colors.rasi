/*
 * Dawn palette for rofi.
 *
 * These are the Dawn colours and they match
 * config/quickshell/dawn-island/theme/Theme.qml and
 * config/kitty/colors/colors.conf. Dawn ships one palette on purpose — the
 * accent comes from your wallpaper at runtime (dawn-island/services/Accent.qml),
 * not from swapping whole colour schemes.
 *
 * Change a colour here and change it in Theme.qml too; the clipboard picker
 * sits directly under the island, so a mismatch is visible.
 */
* {
    background:       #000000;
    background-alt:   #161616;
    background-hover: #202020;
    foreground:       #f2f2f2;
    foreground-dim:   #8f8f8f;
    accent:           #f2f2f2;
    border-colour:    #2b2b2b;
}
