 * Author : Aditya Shakya (adi1090x)
 * Modified : Dawn Monochrome Glass (Jhay)
 *
 * Colors
 **/

* {
    /* Base glass */
    background:     rgba(10, 10, 10, 0.78);   /* strong dark glass */
    background-alt: rgba(22, 22, 22, 0.88);   /* containers solid */

    /* Text stays fully solid */
    foreground:     #e8e8e8FF;

    /* States */
    selected:       rgba(242, 242, 242, 0.92);
    active:         rgba(207, 207, 207, 0.85);
    urgent:         rgba(217, 83, 79, 0.95);
}
